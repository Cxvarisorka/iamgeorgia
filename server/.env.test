# Loaded by `npm test` via node --env-file. Values set here win over .env,
# which still supplies DATABASE_URL.
NODE_ENV=test
LOG_LEVEL=silent
PORT=0

# Mail goes to an in-memory outbox the suite can assert on, and the pepper is
# fixed so a token hashed in one test still resolves in another.
MAIL_TRANSPORT=capture
AUTH_TOKEN_PEPPER=test-pepper
APP_URL=http://localhost:3000

# Media writes to a scratch directory rather than a bucket: the suite must not
# need credentials, a network, or an R2 bucket somebody has to remember to
# empty.
#
# Every one of these is pinned rather than left to default, because dotenv still
# loads `.env` for anything this file does not set — so without them the suite
# would inherit a developer's real R2 configuration and pass or fail depending
# on whose machine it ran on. MEDIA_PUBLIC_BASE_URL is the one that actually
# bit: with a real CDN base, the URLs the tests fetch stop resolving to a route
# this app serves.
MEDIA_DRIVER=local
MEDIA_LOCAL_ROOT=.media-test
MEDIA_PUBLIC_BASE_URL=http://localhost:5000/media
MEDIA_PUBLIC_BUCKET=iag-test-public
MEDIA_PRIVATE_BUCKET=iag-test-private

# The runner gives every test file its own process, and each opens its own
# Prisma pool. At the default of 10 that is 32 files x 10 = 320 connections
# against a Postgres whose max_connections is 100 — which only ever worked
# because the suites rarely fill their pools at the same moment. Adding a few
# more files tipped it over, and the failure looks like an unrelated assertion:
# a query is refused, the route 500s, and a test that expected a body sees
# undefined.
#
# A test process needs two connections, not ten. 32 x 3 leaves headroom for
# psql and the dev server.
DATABASE_POOL_MAX=3
